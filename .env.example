# ── Grafana SMTP (email alerting) ──
# Create a Gmail App Password: Google Account → Security → App passwords
GRAFANA_SMTP_USER=your-email@gmail.com
GRAFANA_SMTP_PASSWORD=your-app-password

# ── Grafana admin ──
GF_SECURITY_ADMIN_PASSWORD=admin

# ── S3 prediction logging (optional) ──
# PREDICTION_LOG_BUCKET=your-s3-bucket-name

# ── MLflow tracking (optional, for train.py) ──
# MLFLOW_TRACKING_URI=http://localhost:5001
