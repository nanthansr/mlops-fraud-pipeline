# Python
__pycache__/
*.py[cod]
*.egg-info/
*.pyc

# Virtual environment
venv/
.venv/

# Data — never commit raw data
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/processed/reference.csv

# Models — tracked by MLflow, not git
# NOTE: models/model.joblib is explicitly committed for deployment
models/*.pkl
models/*.pt
models/*.h5
models/metrics.json

# MLflow
mlruns/
mlartifacts/

# Notebooks checkpoints
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Secrets — NEVER commit these
.env
.env.local
config.local.yml
*.pem
*.key
aws-credentials

# Logs
*.log
logs/

# Dev session files — local only, not for public repo
CLAUDE.md
RAWLOG.md
SESSIONS.md
DEVLOG.md
.claude/
scripts/devlog.py
scripts/study_log.py
CLAUDE_PROJECT_PROMPT.md

# Installers
AWSCLIV2.pkg
